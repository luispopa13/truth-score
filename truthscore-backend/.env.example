# ============================================================
# TruthScore Backend — full configuration reference (.env.example)
# Copy to .env and fill in values.
# ============================================================

# ═════════════ Core AI ════════════════════════════════════
# Gemini — the primary reasoning model (Google AI Studio / Vertex)
GEMINI_API_KEY=your_gemini_api_key

# Groq — cheap fast fallback for simple claims (drastically reduces cost)
GROQ_API_KEY=your_groq_key

# OpenAI — for gpt-4o-mini tier (OPTIONAL, reduces cost on simple claims)
OPENAI_API_KEY=

# ════════════════════════════════════════════════════════════
# ═════════════ Infra ════════════════════════════════════════
# Redis — REQUIRED for horizontal scaling (distributed cache,
# rate-limit, queue).  Use Upstash or a free Redis Cloud instance.
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=truthscore

# ════════════════════════════════════════════════════════════
# ═════════════ Auth/Security ════════════════════════════════
# Use a LONG random string generated with `openssl rand -hex 32`
JWT_SECRET=change_this_to_a_long_random_secret

# Allowed browser origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ════════════════════════════════════════════════════════════
# ═════════════ Monetization (Stripe) ════════════════════════
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_ENT_PRICE_ID=

# ════════════════════════════════════════════════════════════
# ═════════════ Daily quotas per plan (VERIFIED cost-optimized) ══
# Blended cost ≈ $0.004/verdict after all optimizations.
PLAN_FREE_DAILY=10
PLAN_PRO_DAILY=200
PLAN_BUSINESS_DAILY=800
PLAN_ENTERPRISE_DAILY=9999
# Eco-mode thresholds (cheap models, no paid search past this point/day)
PRO_ECO_AFTER=100
BUSINESS_ECO_AFTER=500

# ════════════════════════════════════════════════════════════
# ═════════════ Anti-abuse (all FREE tools) ══════════════════
# Cloudflare Turnstile — get keys free at dash.cloudflare.com
TURNSTILE_SECRET=
# Max accounts creatable per IP per day (botnet/farm guard)
MAX_REGISTRATIONS_PER_IP_PER_DAY=3
# Feedback-bonus gamification: +1 check per unique feedback, capped daily
FEEDBACK_BONUS_DAILY_CAP=10
# Extra disposable email domains to block (comma-separated)
BLOCKED_EMAIL_DOMAINS=

# ════════════════════════════════════════════════════════════
# ═════════════ Sessions & ads ═══════════════════════════════
# Kill account sharing: only newest N logins stay valid (needs Redis)
MAX_CONCURRENT_SESSIONS=2
SESSION_ENFORCE=on
# Free tier ad-support flag (X-TruthScore-Show-Ads response header)
ADS_ENABLED=true

# ════════════════════════════════════════════════════════════
# ═════════════ Search / Data providers ══════════════════════
TAVILY_API_KEY=
HF_TOKEN=
NEWS_API_KEY=

# ── SEARCH COST CONTROL (critical — search is the dominant cost!) ──
# Tavily = $0.008/credit. "basic" depth = 1 credit; "advanced" = 2 credits.
#   always         = old behavior (expensive: fires on every claim)
#   fallback_only  = RECOMMENDED: free sources (DDG/Wikipedia/PubMed/arXiv)
#                    first; pay for Tavily only when evidence is thin (<6)
#   off            = never use Tavily (100% free retrieval)
TAVILY_MODE=fallback_only
TAVILY_DEPTH=basic
MIN_FREE_EVIDENCE=6
# Global daily cap on paid searches across ALL users & instances
PAID_SEARCH_DAILY_CAP=3000

# ════════════════════════════════════════════════════════════
# ═════════════ Cost tuning ══════════════════════════════════
# Max concurrent LLM calls per instance
LLM_CONCURRENCY=8
# Redis connection pool
REDIS_MAX_CONNECTIONS=50

# ── Monetization: Google AdSense (dashboard only, free tier) ────
# Your publisher id from adsense.google.com. Leave EMPTY until approved;
# empty value = no ad script is ever loaded on any surface.
# Extension surfaces stay self-promo-only regardless of this value.
ADSENSE_CLIENT=
# Master switch (also gates Show-Ads headers)
ADS_ENABLED=true